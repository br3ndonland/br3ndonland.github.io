{
  "name": "bws",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.16.1",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "prettier . --check && cspell --dot --gitignore **/*.astro **/*.md* && astro check",
    "check:middleware": "tsc --noEmit --module nodenext --moduleResolution nodenext --target es2022 --strict middleware.ts",
    "dev": "astro dev",
    "fmt": "prettier . --write",
    "preview": "astro preview",
    "start": "astro dev",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test": "vitest run"
  },
  "prettier": {
    "semi": false,
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      },
      {
        "files": [
          "AGENTS.md",
          "SKILL.md"
        ],
        "options": {
          "proseWrap": "never"
        }
      },
      {
        "files": [
          "COMMIT_EDITMSG"
        ],
        "options": {
          "parser": "markdown",
          "printWidth": 72,
          "proseWrap": "always"
        }
      }
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "^0.4.5",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@vercel/functions": "^3.10.3",
    "@videojs/html": "10.2.0",
    "astro": "^7.4.2",
    "astro-expressive-code": "^0.44.3",
    "glightbox": "^3.3.1",
    "node-html-parser": "^9.0.5",
    "pagefind": "~1.5.2",
    "satori": "^0.63.0",
    "satteri": "^0.10.5",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "~4.1.12",
    "cspell": "^9.8.0",
    "prettier": "~3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "vitest": "~4.1.12"
  }
}
