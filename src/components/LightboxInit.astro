<script>
  import "glightbox/dist/css/glightbox.min.css"
  import { GLIGHTBOX_OPTIONS } from "@consts"
  import type { createLightboxVideo } from "../scripts/lightbox-video"

  type VideoPlayer = ReturnType<typeof createLightboxVideo>
  type VideoSlide = {
    slideIndex: number
    trigger: HTMLAnchorElement
    slideConfig: {
      content: HTMLElement
      draggable: boolean
      height: string
      href: string
      type: string
    }
  }

  type LightboxInstance = {
    destroy: () => void
    getAllPlayers: () => Record<string, VideoPlayer>
    on: {
      (event: "slide_before_load", callback: (slide: VideoSlide) => void): void
      (event: "close", callback: () => void): void
    }
    reload: () => void
  }

  type GLightboxModule = {
    default: (options: Record<string, unknown>) => LightboxInstance
  }

  type LightboxState = {
    createVideo: typeof createLightboxVideo | undefined
    instance: LightboxInstance | undefined
    isListening: boolean | undefined
    videoPromise:
      | Promise<typeof import("../scripts/lightbox-video")>
      | undefined
  }

  const videoLightboxSelector = [
    '.glightbox[data-type="video"]',
    '.glightbox[href$=".mov" i]',
    '.glightbox[href$=".mp4" i]',
    '.glightbox[href$=".ogg" i]',
    '.glightbox[href$=".webm" i]',
  ].join(", ")
  const windowWithLightbox = window as Window & {
    bwsLightbox?: LightboxState
  }
  const state = (windowWithLightbox.bwsLightbox ??= {
    createVideo: undefined,
    instance: undefined,
    isListening: undefined,
    videoPromise: undefined,
  })

  const initLightbox = async () => {
    const lightboxLinks = document.querySelectorAll(".glightbox")

    if (lightboxLinks.length === 0) {
      state.instance?.destroy()
      state.instance = undefined
      return
    }

    if (document.querySelector(videoLightboxSelector)) {
      state.videoPromise ??= import("../scripts/lightbox-video")
      state.createVideo = (await state.videoPromise).createLightboxVideo
    }

    if (state.instance) {
      state.instance.reload()
      return
    }

    const { default: GLightbox } = (await import(
      "glightbox"
    )) as unknown as GLightboxModule

    const instance = GLightbox(GLIGHTBOX_OPTIONS)
    state.instance = instance

    instance.on("slide_before_load", ({ slideIndex, trigger, slideConfig }) => {
      if (!trigger?.matches(videoLightboxSelector) || !state.createVideo) return

      // Navigation can repeat this event before a preload finishes.
      const player = (instance.getAllPlayers()[`gvideo${slideIndex}`] ??=
        state.createVideo(trigger.href, slideIndex))

      // Inline content bypasses GLightbox's built-in Plyr loader. Its player
      // registry still handles pausing on gallery navigation and close.
      Object.assign(slideConfig, {
        content: player.elements.container,
        draggable: false,
        height: "auto",
        href: "",
        type: "inline",
      })
    })
    instance.on("close", () => {
      const players = instance.getAllPlayers()
      for (const [id, player] of Object.entries(players)) {
        player.destroy()
        delete players[id]
      }
    })
  }

  if (!state.isListening) {
    document.addEventListener("astro:page-load", initLightbox)
    state.isListening = true
  }

  void initLightbox()
</script>
