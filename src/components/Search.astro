---
import Icon from "./Icon.astro"

const baseUrl = import.meta.env.BASE_URL
const pagefindBundlePath = `${baseUrl.replace(/\/$/, "")}/pagefind/`
const pagefindComponentScript = `${pagefindBundlePath}pagefind-component-ui.js`
const pagefindComponentStyles = `${pagefindBundlePath}pagefind-component-ui.css`

const labels = {
  cancel: "Cancel",
  devWarning: "Search has only been implemented for production builds",
  search: "Search",
}
---

<site-search>
  {
    import.meta.env.DEV ? (
      <template>
        <button
          data-dev-open-modal
          disabled
          aria-label={labels.search}
          aria-keyshortcuts="Control+K Meta+K"
        >
          <Icon
            icon="magnifying-glass"
            gradient={false}
            size="var(--icon-size)"
          />
          <span class="d-none xl:d-block" aria-hidden="true">
            {labels.search}
          </span>
          <kbd class="d-none xl:d-flex" aria-hidden="true">
            <>
              <kbd>Ctrl</kbd>
              <kbd>K</kbd>
            </>
          </kbd>
        </button>
        <dialog data-dev-modal aria-label={labels.search}>
          <div class="dev-dialog-frame">
            <button data-dev-close-modal>{labels.cancel}</button>
            <p>{labels.devWarning}</p>
          </div>
        </dialog>
      </template>
    ) : (
      <>
        <link rel="stylesheet" href={pagefindComponentStyles} />
        <pagefind-config base-url={baseUrl} bundle-path={pagefindBundlePath} />
        <pagefind-modal-trigger
          compact
          hide-shortcut
          placeholder={labels.search}
        />
        <pagefind-modal reset-on-close />
        <script is:inline type="module" src={pagefindComponentScript} />
      </>
    )
  }
</site-search>

<script>
  import { bindSearchResultNavigation } from "../utils/search"

  class SiteSearch extends HTMLElement {
    constructor() {
      super()

      const template = this.querySelector("template")
      if (template) {
        this.appendChild(template.content.cloneNode(true))
        this.initDevSearch()
        return
      }

      const trigger = this.querySelector("pagefind-modal-trigger")
      const modal = this.querySelector<HTMLElement & { close?: () => void }>(
        "pagefind-modal",
      )
      if (!trigger || !modal) return

      bindSearchResultNavigation(this, modal)

      const expandedTrigger = window.matchMedia("(min-width: 75em)")
      const updateTrigger = ({
        matches,
      }: MediaQueryList | MediaQueryListEvent) => {
        trigger.toggleAttribute("compact", !matches)
        trigger.toggleAttribute("hide-shortcut", !matches)
      }

      updateTrigger(expandedTrigger)
      expandedTrigger.addEventListener("change", updateTrigger)
    }

    private initDevSearch() {
      const openButton = this.querySelector<HTMLButtonElement>(
        "button[data-dev-open-modal]",
      )
      const closeButton = this.querySelector<HTMLButtonElement>(
        "button[data-dev-close-modal]",
      )
      const dialog = this.querySelector<HTMLDialogElement>(
        "dialog[data-dev-modal]",
      )
      if (!openButton || !closeButton || !dialog) return

      const openModal = () => {
        dialog.showModal()
        closeButton.focus()
      }
      const closeModal = () => dialog.close()

      openButton.disabled = false
      openButton.addEventListener("click", openModal)
      closeButton.addEventListener("click", closeModal)
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) closeModal()
      })
      dialog.addEventListener("close", () => openButton.focus())

      window.addEventListener("keydown", (event) => {
        if (
          (event.metaKey || event.ctrlKey) &&
          event.key.toLowerCase() === "k"
        ) {
          dialog.open ? closeModal() : openModal()
          event.preventDefault()
        }
      })
    }
  }

  if (!customElements.get("site-search")) {
    customElements.define("site-search", SiteSearch)
  }
</script>

<style>
  site-search {
    --icon-size: 0.75em;
    --pf-background: var(--gray-999);
    --pf-border: var(--gray-700);
    --pf-border-focus: var(--gray-300);
    --pf-border-radius: 0.5rem;
    --pf-font: var(--font-body);
    --pf-hover: var(--gray-900);
    --pf-input-font-size: var(--text-base);
    --pf-input-height: 2.5rem;
    --pf-mark: var(--link-color);
    --pf-modal-backdrop: var(--accent-subtle-overlay);
    --pf-modal-max-height: calc(100dvh - 8rem);
    --pf-modal-max-width: 40rem;
    --pf-modal-top: 4rem;
    --pf-outline-focus: var(--accent-regular);
    --pf-outline-offset: 2px;
    --pf-outline-width: 2px;
    --pf-scroll-shadow: var(--gray-999_40);
    --pf-shadow-lg: var(--shadow-lg);
    --pf-shadow-md: var(--shadow-md);
    --pf-shadow-sm: var(--shadow-sm);
    --pf-skeleton: var(--gray-800);
    --pf-skeleton-shine: var(--gray-900);
    --pf-text: var(--gray-0);
    --pf-text-muted: var(--gray-400);
    --pf-text-secondary: var(--gray-200);
    display: contents;
  }

  pagefind-modal-trigger {
    align-self: center;
    margin: 0 0.5rem;
  }

  button {
    font-family: var(--font-body);
  }

  button[data-dev-open-modal] {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    margin: 0 0.5rem;
    border: 0;
    background-color: transparent;
    color: var(--gray-100);
    cursor: pointer;
    font-size: var(--text-xl);
  }

  button[data-dev-open-modal] > :last-child {
    margin-inline-start: auto;
  }

  button > kbd {
    display: flex;
    gap: 0.25em;
    padding-inline: 0.375rem;
    border-radius: 0.25rem;
    background-color: var(--gray-800);
    font-size: var(--text-sm);
  }

  kbd {
    font-family: var(--font-body);
  }

  dialog[data-dev-modal] {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 1px solid var(--gray-700);
    background-color: var(--gray-800);
    box-shadow: var(--shadow-lg);
    color: var(--gray-200);
  }

  dialog[data-dev-modal]::backdrop {
    background-color: var(--accent-subtle-overlay);
    -webkit-backdrop-filter: blur(0.25rem);
    backdrop-filter: blur(0.25rem);
  }

  .dev-dialog-frame {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    padding: 1rem;
  }

  .dev-dialog-frame button {
    align-self: flex-end;
    border: 0;
    background: transparent;
    color: var(--accent-dark);
    cursor: pointer;
  }

  .dev-dialog-frame p {
    margin: auto;
    direction: ltr;
    text-align: center;
  }

  @media (min-width: 50rem) {
    site-search {
      --icon-size: 1.2em;
    }

    pagefind-modal-trigger {
      width: 100%;
      max-width: 22rem;
    }

    button[data-dev-open-modal] {
      width: 100%;
      max-width: 22rem;
      padding-inline: 0.5rem;
      border: 1px solid var(--gray-600);
      border-radius: 0.5rem;
      background-color: var(--gray-999);
      color: var(--gray-200);
      font-size: var(--text-base);
    }

    button[data-dev-open-modal]:hover {
      border-color: var(--gray-200);
      color: var(--gray-0);
    }

    dialog[data-dev-modal] {
      width: 90%;
      max-width: 40rem;
      height: max-content;
      min-height: 15rem;
      margin: 4rem auto auto;
      border-radius: 0.5rem;
    }

    .dev-dialog-frame {
      min-height: 15rem;
      padding: 1.5rem;
    }
  }
</style>

<style is:global>
  body:has(site-search dialog[open]) {
    overflow: hidden;
  }

  site-search .pf-result-excerpt,
  site-search .pf-heading-excerpt {
    white-space: normal !important;
  }

  site-search .pf-result:has(.pf-heading-chips) .pf-result-excerpt {
    display: none !important;
  }

  @media (hover: none) {
    site-search pagefind-modal-footer {
      display: none !important;
    }
  }
</style>
